{
  "name": "repair-system",
  "private": true,
  "description": "社區修繕管理系統 — Cloudflare Pages + Hono + D1 + R2 + LINE LIFF",
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev public",
    "deploy": "wrangler pages deploy public",
    "db:migrate:local": "wrangler d1 migrations apply repair-db0818 --local",
    "db:migrate:remote": "wrangler d1 migrations apply repair-db0818 --remote",
    "test": "vitest run",
    "test:local": "vitest run --config vitest.node.config.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"**/*.{js,ts,json}\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.1",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^5.20260818.1",
    "@playwright/test": "^1.62.1",
    "jsdom": "^25.0.1",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.123.0"
  }
}
